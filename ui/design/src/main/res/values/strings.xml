    <string name="implementation_method">Implementation</string>
    <string name="implementation_auto">Auto</string>
    <string name="implementation_auto_summary">Select by availability and backend priority, with fallback when allowed.</string>
    <string name="implementation_requirements_format">Requires: %1$s</string>
    <string name="implementation_pros_format">Advantages: %1$s</string>
    <string name="implementation_cons_format">Limitations: %1$s</string>
    <string name="implementation_restart_note">Hook or scope changes may require restarting the target process or device.</string>
    <string name="implementation_root_summary">Execute with the highest system privileges through su.</string>
    <string name="implementation_root_pro_1">Broadest permission coverage</string>
    <string name="implementation_root_pro_2">Best compatibility for most shell and package-management operations</string>
    <string name="implementation_root_pro_3">Does not depend on the Shizuku service</string>
    <string name="implementation_root_con_1">Grants a high level of privilege, so mistakes have greater impact</string>
    <string name="implementation_root_con_2">Requires authorization from the Root manager</string>
    <string name="implementation_root_con_3">Some apps pay attention to a rooted device environment</string>
    <string name="implementation_shizuku_summary">Execute with shell privileges through a Shizuku UserService.</string>
    <string name="implementation_shizuku_pro_1">YAuto does not need direct Root authorization</string>
    <string name="implementation_shizuku_pro_2">Permission scope is usually narrower than Root</string>
    <string name="implementation_shizuku_pro_3">Disabling Shizuku immediately disables the capability</string>
    <string name="implementation_shizuku_con_1">Requires the Shizuku service to remain available</string>
    <string name="implementation_shizuku_con_2">Some commands are restricted by shell UID permissions</string>
    <string name="implementation_shizuku_con_3">Shizuku may need to be started again after reboot</string>
    <string name="implementation_lsposed_summary">Use the system_server / SystemUI Hook bridge to call system capabilities.</string>
    <string name="implementation_lsposed_pro_1">More direct call path and usually faster than shell</string>
    <string name="implementation_lsposed_pro_2">Can access internal APIs unavailable through shell</string>
    <string name="implementation_lsposed_pro_3">Well suited to deep SystemUI, window and task features</string>
    <string name="implementation_lsposed_con_1">Depends on LSPosed and the correct scope</string>
    <string name="implementation_lsposed_con_2">Android or ROM updates can require Hook adaptation</string>
    <string name="implementation_lsposed_con_3">New or changed Hooks commonly require a process or device restart</string>
    <string name="implementation_accessibility_summary">Execute UI interactions through the Android Accessibility service.</string>
    <string name="implementation_accessibility_pro_1">Does not require Root</string>
    <string name="implementation_accessibility_pro_2">Works across a broad range of app UIs</string>
    <string name="implementation_accessibility_pro_3">Uses an official Android service model</string>
    <string name="implementation_accessibility_con_1">Depends on accessible UI nodes</string>
    <string name="implementation_accessibility_con_2">Some apps hide or custom-render their UI</string>
    <string name="implementation_accessibility_con_3">Capabilities are limited while the screen is off</string>
