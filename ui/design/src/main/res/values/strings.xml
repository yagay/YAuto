    <string name="engine_capability_broker_title">Capability Broker</string>
    <string name="engine_capability_broker_detail">Each semantic feature is defined once. Runtime selects an available Android / Accessibility / Shizuku / Root / LSPosed implementation.</string>
    <string name="engine_fallback_title">Failure and fallback</string>
    <string name="engine_fallback_detail">Unavailable backends, missing permissions and execution failures record their reason. Auto mode may try the next backend without duplicating the feature.</string>
    <string name="engine_backend_selection_title">Backend selection</string>
    <string name="engine_backend_selection_detail">Auto follows real backend priority and may fall back. A manually selected Root / Shizuku / LSPosed backend is strict and will not silently switch to another backend.</string>
    <string name="engine_execution_safety_title">Execution safety</string>
    <string name="engine_execution_safety_detail">Flows enforce overall runtime, recursion depth, loop count, command timeout and output-size limits. Cancellation propagates to lower layers.</string>
    <string name="engine_execution_trace_title">Execution tracing</string>
    <string name="engine_execution_trace_detail">Every Automation / Flow / Node / Feature trace records the selected backend, duration, result and exception for diagnostics and AI analysis.</string>

